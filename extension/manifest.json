{
  "manifest_version": 3,
  "name": "SceneLingo",
  "version": "0.9.0",
  "description": "Film, dizi ve video izlerken dil öğren: çift altyazı, kelime çevirisi ve telaffuzu, yazma ve konuşma alıştırması, kelime tekrarı.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "SceneLingo", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.de/gp/video/*",
        "https://*.amazon.co.jp/gp/video/*",
        "https://*.amazon.com.tr/gp/video/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": ["youtube.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.de/gp/video/*",
        "https://*.amazon.co.jp/gp/video/*",
        "https://*.amazon.com.tr/gp/video/*",
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": ["shared.js", "core.js", "subtitles.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
