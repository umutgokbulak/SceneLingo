{
  "manifest_version": 3,
  "key": "",
  "name": "SceneLingo",
  "version": "0.34.1",
  "description": "__MSG_description__",
  "default_locale": "en",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "scripting",
    "tabCapture",
    "offscreen",
    "activeTab",
    "contextMenus",
    "alarms",
    "identity",
    "notifications"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SceneLingo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.de/gp/video/*",
        "https://*.amazon.co.jp/gp/video/*",
        "https://*.amazon.com.tr/gp/video/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "netflix.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.de/gp/video/*",
        "https://*.amazon.co.jp/gp/video/*",
        "https://*.amazon.com.tr/gp/video/*",
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "messages.js",
        "shared.js",
        "study.js",
        "core.js",
        "subtitles.js",
        "episode.js",
        "nouns.js",
        "overlay-base.js",
        "overlay-tracks.js",
        "overlay-lines.js",
        "overlay-words.js",
        "overlay-practice.js",
        "overlay-ui.js",
        "overlay-episode.js",
        "content.js",
        "select.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
