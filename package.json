{
  "name": "scenelingo",
  "version": "0.34.1",
  "private": true,
  "description": "Browser extension for learning a language from films, series and videos: dual subtitles, word lookup with audio, writing and speaking practice, spaced-repetition review.",
  "keywords": ["language-learning", "subtitles", "browser-extension", "manifest-v3", "prime-video", "youtube", "hls", "spaced-repetition"],
  "author": "Umut",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/umutgokbulak/SceneLingo.git" },
  "homepage": "https://github.com/umutgokbulak/SceneLingo#readme",
  "bugs": "https://github.com/umutgokbulak/SceneLingo/issues",
  "scripts": {
    "test": "node --test \"test/unit/*.test.js\"",
    "typecheck": "npx -y -p typescript@5.6.3 tsc -p .",
    "harness": "node test/server.js",
    "check:live": "node test/live-check.js",
    "check:youtube": "node test/real-browser.js",
    "check:sites": "node test/real-browser.js sites",
    "check:pages": "node test/pages.js",
    "pictures": "node test/pictures.js",
    "pictures:pages": "node test/pages.js pictures",
    "film": "node test/pictures.js frames",
    "check:netflix": "node test/netflix-check.js",
    "check:demo": "node test/live-demo.js",
    "icons": "node test/icons.js"
  },
  "engines": { "node": ">=22" }
}
