<?xml version="1.0" encoding="utf-8"?>
<!-- An all-capitals caption track, as older closed captions are written. -->
<tt xmlns="http://www.w3.org/ns/ttml" xml:lang="en"><body><div>
<p begin="00:00:02.000" end="00:00:04.000">- I'LL TAKE IT.</p>
<p begin="00:00:05.000" end="00:00:06.500">- UNFORTUNATELY,</p>
<p begin="00:00:06.600" end="00:00:09.000">WE ONLY HIRE<br/>LOCAL GRADUATES.</p>
<p begin="00:00:10.000" end="00:00:12.500">IT WON'T RAIN TODAY.</p>
</div></body></tt>
